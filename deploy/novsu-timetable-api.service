[Unit]
Description=NovSU timetable JSON API
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/novsu-timetable-api
EnvironmentFile=/root/novsu-timetable-api/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /root/novsu-timetable-api/api.py --host 127.0.0.1 --port 8787
Restart=always
RestartSec=20
# Изоляция: отдельный пользователь, без повышения привилегий, только state/ на запись.
# Скрины рендерит /usr/bin/google-chrome (не snap), поэтому NoNewPrivileges= допустим;
# /root открыт пользователю novsu только на проход (ACL u:novsu:x).
User=novsu
Group=novsu
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=false
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
MemoryMax=384M
ReadWritePaths=/root/novsu-timetable-api/state

[Install]
WantedBy=multi-user.target
