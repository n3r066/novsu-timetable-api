[Unit]
Description=NovSU timetable JSON API
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/novsu-timetable-api
EnvironmentFile=/root/novsu-timetable-api/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /root/novsu-timetable-api/api.py --host 127.0.0.1 --port 8787
Restart=always
RestartSec=20
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/root/novsu-timetable-api/state

[Install]
WantedBy=multi-user.target
