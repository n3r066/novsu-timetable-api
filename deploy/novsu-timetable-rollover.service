[Unit]
Description=NovSU timetable pinned-post midnight rollover (Europe/Moscow)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/root/novsu-timetable-api
EnvironmentFile=/root/novsu-timetable-api/.env
# Без этого python буферизует stdout и в журнале ничего не видно.
Environment=PYTHONUNBUFFERED=1
# Ролловер закрепа: прошедшие дни учебной недели убираются из поста, а в
# ночь на воскресенье пост переключается на следующую неделю. MESSAGE_ID
# берётся из NOVSU_DASHBOARD_POST_ID в .env.
ExecStart=/usr/bin/python3 /root/novsu-timetable-api/post.py --roll
# Изоляция: отдельный пользователь, без повышения привилегий, только state/ на запись.
# Скрины рендерит /usr/bin/google-chrome (не snap), поэтому NoNewPrivileges= допустим;
# /root открыт пользователю novsu только на проход (ACL u:novsu:x).
User=novsu
Group=novsu
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=false
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
MemoryMax=1G
ReadWritePaths=/root/novsu-timetable-api/state
