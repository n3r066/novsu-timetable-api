[Unit]
Description=NovSU timetable change monitor
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/novsu-timetable-api
EnvironmentFile=/root/novsu-timetable-api/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /root/novsu-timetable-api/monitor.py --interval 3 --jitter 0.25 --update-post 3
Restart=always
RestartSec=20
TimeoutStopSec=20
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/root/novsu-timetable-api/state

[Install]
WantedBy=multi-user.target
