[Unit]
Description=NovSU timetable change monitor
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/novsu-timetable-api
EnvironmentFile=/root/novsu-timetable-api/.env
ExecStart=/usr/bin/python3 /root/novsu-timetable-api/monitor.py --interval 10 --jitter 2
Restart=always
RestartSec=20
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/root/novsu-timetable-api/state

[Install]
WantedBy=multi-user.target
